name: Verify fruitmarket-production
on:
  push:
    branches: [main]
  pull_request:
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npm run check
      - run: npm run build
      - name: Secret scan
        run: '! grep -R -E "(test|live)_sk_[A-Za-z0-9_-]+" site supabase scripts .github'
